<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Шлагбаум Реле — прототип" android:textSize="20sp"
            android:paddingBottom="12dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Адрес вашего сервера" />
        <EditText android:id="@+id/etServer" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textUri" android:hint="http://адрес-сервера:8080" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:paddingTop="2dp"
            android:text="Нужен запущенный сервер (папка server/). Без него приложение не работает. См. руководство." />

        <TextView android:id="@+id/tvRole" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingTop="12dp" android:text="Роль не выбрана" />

        <Button android:id="@+id/btnRoleController" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Это пульт (телефон A)" />
        <Button android:id="@+id/btnRoleReceiver" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Это приёмник (телефон B)" />

        <Button android:id="@+id/btnOpenRole" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Открыть экран роли" android:enabled="false" />

        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="16dp" android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
